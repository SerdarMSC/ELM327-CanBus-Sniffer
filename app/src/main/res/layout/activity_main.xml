<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/obd_bg"
    android:fitsSystemWindows="false"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp">

    <!-- baslik -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="@string/app_name" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="CAN MONITOR"
            android:textColor="@color/obd_primary"
            android:textSize="16sp"
            android:typeface="monospace"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvVersion"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:paddingBottom="1dp"
            android:gravity="bottom"
            android:text="v1.0.3"
            android:textColor="@color/obd_text_dim"
            android:textSize="10sp"
            android:typeface="monospace" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginTop="8dp"
        android:background="@color/obd_primary_dim" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="ELM327: Bagli degil"
        android:textColor="@color/obd_text_dim"
        android:typeface="monospace"
        android:textSize="13sp" />

    <Spinner
        android:id="@+id/spProtocol"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:popupBackground="@color/obd_surface"
        android:backgroundTint="@color/obd_primary" />

    <Button
        android:id="@+id/btnConnect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_button"
        android:textColor="@color/btn_text"
        android:typeface="monospace"
        android:text="CIHAZA BAGLAN" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Filter ID (hex):"
        android:textColor="@color/obd_text_dim"
        android:typeface="monospace"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etFilterId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:padding="10dp"
        android:background="@drawable/bg_input"
        android:hint="250"
        android:textColorHint="@color/obd_text_dim"
        android:textColor="@color/obd_amber"
        android:textStyle="bold"
        android:typeface="monospace"
        android:inputType="textCapCharacters"
        android:maxLength="8"
        android:digits="0123456789ABCDEFabcdef"
        android:importantForAutofill="no" />

    <!-- tablo basligi -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Time"
            android:textColor="@color/obd_primary"
            android:typeface="monospace"
            android:textSize="13sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="CAN ID"
            android:textColor="@color/obd_primary"
            android:typeface="monospace"
            android:textSize="13sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_weight="2"
            android:layout_height="wrap_content"
            android:text="DATA"
            android:textColor="@color/obd_amber"
            android:typeface="monospace"
            android:textSize="13sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:background="@color/obd_line" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFrames"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:scrollbars="vertical" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/obd_line" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnStart"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_button"
            android:textColor="@color/btn_text"
            android:typeface="monospace"
            android:textSize="12sp"
            android:text="START LOG" />

        <Button
            android:id="@+id/btnStop"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_button"
            android:textColor="@color/btn_text"
            android:typeface="monospace"
            android:textSize="12sp"
            android:text="STOP" />

        <Button
            android:id="@+id/btnShare"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_button"
            android:textColor="@color/btn_text"
            android:typeface="monospace"
            android:textSize="12sp"
            android:text="PAYLAS" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Frames: 0"
        android:textColor="@color/obd_text_dim"
        android:typeface="monospace"
        android:textSize="13sp" />

</LinearLayout>
